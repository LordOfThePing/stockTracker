# Binance read-only API credentials (Phase 2 only).
# Create at https://www.binance.com/en/my/settings/api-management
# Enable "Reading" ONLY. Disable trading, withdrawals, and futures.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Backend
DATABASE_URL=sqlite:///./data/tracker.db
SYNC_INTERVAL_SECONDS=900
SYNC_JITTER_SECONDS=120

# Frontend (browser hits backend over the host's loopback port)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Cloudflare Tunnel token (production only — from Zero Trust → Tunnels → your tunnel → Configure)
CLOUDFLARE_TUNNEL=
